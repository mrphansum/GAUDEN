# Sao chép file này thành .env rồi chỉnh giá trị cho máy Windows của bạn.
# Copy this file to .env and adjust values for your Windows machine.

PORT=4000
NODE_ENV=development

# MongoDB local (cài MongoDB Community trên Windows)
MONGODB_URI=mongodb://127.0.0.1:27017/gauden

# JWT secrets — ĐỔI trong production, dùng chuỗi dài ngẫu nhiên
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google Sign-In (OAuth 2.0 Web + iOS client IDs từ Google Cloud Console)
# Web client ID dùng để verify idToken phía server
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# iOS client ID (optional, dùng nếu token audience là iOS client)
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# IAP: bật mock verify khi dev (true = không gọi Apple, tin transactionId)
IAP_MOCK_VERIFY=true

# App Store Connect shared secret (subscriptions) — Non-Consumable verify chủ yếu qua JWS/StoreKit2
# APPLE_SHARED_SECRET=
# APPLE_BUNDLE_ID=com.mrphansum.homeapplicationfix

# CORS: origin của app / tool dev (dấu phẩy nếu nhiều)
CORS_ORIGIN=*
